<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:theme="@style/Theme.DirtyFrag">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Page header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="@string/settings_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Run Behavior Section -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/run_behavior"
                android:textColor="?attr/accentInk" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/settings_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <!-- KernelSU Module -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_module" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/modulesTitle"
                                style="@style/RowTitle"
                                android:text="@string/ksu_modules" />

                            <TextView
                                android:id="@+id/modulesSubtitle"
                                style="@style/RowSubtitle"
                                android:text="@string/modules_enabled" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchModules"
                            style="@style/SettingsSwitch" />

                    </LinearLayout>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp" />

                    <!-- Expert Mode -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_expert" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/expertModeLabel"
                                style="@style/RowTitle"
                                android:text="@string/expert_mode" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="@string/expert_mode_desc" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchExpertMode"
                            style="@style/SettingsSwitch" />

                    </LinearLayout>

                    <!-- Auto Run on Boot (expert mode only) -->
                    <LinearLayout
                        android:id="@+id/cardAutorun"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            style="@style/SectionDivider"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp" />

                        <LinearLayout style="@style/SettingsRow">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_settings_icon"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_autorun" />

                            <LinearLayout
                                style="@style/RowText"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvAutorunTitle"
                                    style="@style/RowTitle"
                                    android:text="@string/autorun" />

                                <TextView
                                    android:id="@+id/tvAutorunDesc"
                                    style="@style/RowSubtitle"
                                    android:text="@string/autorun_desc" />

                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchBootStart"
                                style="@style/SettingsSwitch" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Auto Soft Reboot (expert mode only) -->
                    <LinearLayout
                        android:id="@+id/cardAutoReboot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            style="@style/SectionDivider"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp" />

                        <LinearLayout style="@style/SettingsRow">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_settings_icon"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_reboot" />

                            <LinearLayout
                                style="@style/RowText"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvRebootTitle"
                                    style="@style/RowTitle"
                                    android:text="@string/auto_reboot" />

                                <TextView
                                    android:id="@+id/tvRebootDesc"
                                    style="@style/RowSubtitle"
                                    android:text="@string/auto_reboot_desc" />

                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchAutoSoftReboot"
                                style="@style/SettingsSwitch" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Appearance Section -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance"
                android:textColor="?attr/accentInk" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/settings_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <!-- Theme -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_theme" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/RowTitle"
                                android:text="@string/theme" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="@string/theme_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/themeSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/themeLight"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/theme_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/themeDark"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/theme_dark" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp" />

                    <!-- Accent tone -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_palette" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/RowTitle"
                                android:text="@string/tone" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="@string/tone_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toneSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toneTeal"
                            style="@style/SettingsSegmentButton"
                            app:icon="@drawable/bg_tone_swatch"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/tone_teal_fill" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toneBlue"
                            style="@style/SettingsSegmentButton"
                            app:icon="@drawable/bg_tone_swatch"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/tone_blue_fill" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tonePurple"
                            style="@style/SettingsSegmentButton"
                            app:icon="@drawable/bg_tone_swatch"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/tone_purple_fill" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toneAmber"
                            style="@style/SettingsSegmentButton"
                            app:icon="@drawable/bg_tone_swatch"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/tone_amber_fill" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp" />


                    <!-- Font -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_font" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/RowTitle"
                                android:text="@string/font" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="@string/font_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/fontSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/fontSystem"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/font_system" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/fontFangYuan"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/font_fangyuan" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp" />

                    <!-- Language -->
                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_language" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/RowTitle"
                                android:text="@string/language" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="@string/language_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/languageSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageZh"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/language_chinese" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageZhTw"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/language_chinese_traditional" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageEn"
                            style="@style/SettingsSegmentButton"
                            android:text="@string/language_english" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/about"
                android:textColor="?attr/accentInk" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/settings_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/rowUpdateCheck"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_update" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/RowTitle"
                                android:text="@string/update_check" />

                            <TextView
                                android:id="@+id/updateCheckVersion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_tertiary"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:id="@+id/rowCommunity"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_community" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/communityLabel"
                                style="@style/RowTitle"
                                android:text="@string/community" />

                            <TextView
                                android:id="@+id/communityDesc"
                                style="@style/RowSubtitle"
                                android:text="@string/community_desc" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_tertiary"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:id="@+id/rowFork"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_github" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/repoForkLabel"
                                style="@style/RowTitle"
                                android:text="@string/repo_fork" />

                            <TextView
                                android:id="@+id/repoForkUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/repo_fork_url"
                                android:textColor="?attr/accentInk"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_tertiary"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View
                        style="@style/SectionDivider"
                        android:layout_marginStart="48dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:id="@+id/rowOriginal"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_settings_icon"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_github" />

                        <LinearLayout
                            style="@style/RowText"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/repoOriginalLabel"
                                style="@style/RowTitle"
                                android:text="@string/repo_original" />

                            <TextView
                                android:id="@+id/repoOriginalUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/repo_original_url"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_tertiary"
                            android:textSize="20sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
