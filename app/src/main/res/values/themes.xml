<resources>
    <style name="Theme.DirtyFrag" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        
        <!-- Window colors -->
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorSurfaceContainerLow">@color/surface_1</item>
        <item name="colorSurfaceContainer">@color/surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_3</item>
        <item name="colorSurfaceContainerHighest">@color/surface_4</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOutline">@color/line_subtle</item>
        <item name="colorControlActivated">@color/accent_ink</item>

        <!-- Primary colors -->
        <item name="colorPrimary">@color/accent_ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/muted_cyan</item>
        <item name="colorOnPrimaryContainer">@color/accent_ink</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent_ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/muted_cyan</item>
        <item name="colorOnSecondaryContainer">@color/accent_ink</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/accent_amber</item>
        <item name="colorOnTertiary">@color/surface_0</item>
        <item name="colorTertiaryContainer">@color/muted_amber</item>
        <item name="colorOnTertiaryContainer">@color/accent_amber</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Background -->
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Outline -->
        <item name="colorOutline">@color/surface_3</item>
        
        <!-- Interaction colors -->
        <item name="colorControlHighlight">#332F6F73</item>
        
        <!-- Text appearances -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Material3.LabelLarge</item>
        
        <!-- Splash screen -->
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        
        <!-- Popup menu -->
        <item name="popupMenuStyle">@style/DF_PopupMenu</item>
        <item name="android:popupMenuStyle">@style/DF_PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/DF_OverflowMenu</item>
        <item name="dropDownListViewStyle">@style/DF_DropDownListView</item>
        <item name="android:itemTextAppearance">@style/DF_MenuText</item>
        <item name="textAppearanceListItemSmall">@style/DF_MenuText</item>
        <item name="listPreferredItemHeightSmall">56dp</item>
        <item name="listPreferredItemPaddingLeft">12dp</item>
        <item name="listPreferredItemPaddingRight">12dp</item>
    </style>
    
    <style name="DF_MenuText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
    </style>
    
    <style name="ShapeCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    
    <style name="DF_PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">24dp</item>
    </style>
    
    <style name="DF_OverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">24dp</item>
    </style>
    
    <style name="DF_DropDownListView" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@drawable/menu_divider</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:listSelector">@drawable/menu_item_ripple</item>
    </style>
    
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
